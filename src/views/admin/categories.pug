extends ../layouts/admin

block styles
  link(rel="stylesheet" href="/assets/css/categories.css")

block content
  .categories-container
    .categories-header
      h1.categories-title Catégories de tickets
      button.btn#addCategoryBtn
        i.fas.fa-plus
        |  Ajouter une catégorie

    .categories-list
      table#categoriesTable
        thead
          tr
            th Nom
            th Description
            th Couleur
            th Actions
        tbody
          // Les catégories seront chargées dynamiquement ici

    // Modal pour ajouter/modifier une catégorie
    .modal#categoryModal
      .modal-content
        .modal-header
          h5.modal-title#categoryModalTitle Ajouter une catégorie
          button.close-btn &times;
        .modal-body
          form#categoryForm
            .form-group
              label(for="categoryName") Nom
              input#categoryName(type="text" required)
            .form-group
              label(for="categoryDescription") Description
              textarea#categoryDescription(rows="3")
            .form-group
              label(for="categoryColor") Couleur
              input#categoryColor(type="color")
        .modal-footer
          button.btn.btn-secondary.close-modal Annuler
          button.btn.btn-primary#saveCategoryBtn(type="submit") Enregistrer

block scripts
  script(src="/assets/js/categories-manager.js")
  script.
    $(document).ready(function() {
      const categoriesManager = new CategoriesManager();
      categoriesManager.init();
    }); 