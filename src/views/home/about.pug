                    img.team-image(src="https://media.licdn.com/dms/image/v2/D5603AQHI4GRkbH5AXg/profile-displayphoto-shrink_200_200/profile-displayphoto-shrink_200_200/0/1684137032453?e=1749686400&v=beta&t=dwx7XNZiOwMypvRwG3_t77ka1esrskH9N9WlmyUhByg" alt="Léo DOUSSET")
