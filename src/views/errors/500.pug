extends ../layouts/main

block content
  .error-page
    .error-content
      h1 500
      h2 Erreur serveur
      p= message || "Une erreur interne du serveur s'est produite. Veuillez réessayer plus tard."
      
      if error && Object.keys(error).length
        .error-details
          h3 Détails de l'erreur
          pre= JSON.stringify(error, null, 2)
      
      a.btn.btn-primary(href='/')
        i.fas.fa-home
        |  Retour à l'accueil 