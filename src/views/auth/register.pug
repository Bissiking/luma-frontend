extends ../layouts/main

block content
  .auth-page
    .container
      .auth-card
        .auth-header
          h2 Inscription
          p Créez votre compte #{appName}
        
        .auth-message.hidden#error-message
          .auth-message-content
            span#error-text
        
        form.auth-form#register-form
          .form-group
            label(for='username') Nom d'utilisateur
            input#username.form-control(type='text', name='username', required)
          
          .form-group
            label(for='email') Email
            input#email.form-control(type='email', name='email', required)
          
          .form-row
            .form-group.form-group-row
              label(for='password') Mot de passe
              input#password.form-control(type='password', name='password', required)
            
            .form-group.form-group-row
              label(for='confirmPassword') Confirmer le mot de passe
              input#confirmPassword.form-control(type='password', name='confirmPassword', required)
          
          .form-group.terms
            label.checkbox
              input(type='checkbox', name='terms', required)
              span 
                | J'accepte les 
                a(href='/terms') conditions d'utilisation
                |  et la 
                a(href='/privacy') politique de confidentialité
          
          .form-actions
            button.btn.btn-primary(type='submit') S'inscrire
        
        .auth-footer
          p
            | Vous avez déjà un compte ? 
            a(href='/auth/login') Se connecter

block scripts
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const registerForm = document.getElementById('register-form');
      const errorMessage = document.getElementById('error-message');
      const errorText = document.getElementById('error-text');
      
      // Récupérer l'URL de l'API depuis les variables globales
      const apiUrl = window.API_URL || 'https://dev.api.mhemery.fr';
      console.log('Utilisation de l\'API URL:', apiUrl);
      
      registerForm.addEventListener('submit', function(e) {
        e.preventDefault();
        
        // Récupérer les valeurs du formulaire
        const username = document.getElementById('username').value;
        const email = document.getElementById('email').value;
        const password = document.getElementById('password').value;
        const confirmPassword = document.getElementById('confirmPassword').value;
        
        // Vérifier que les mots de passe correspondent
        if (password !== confirmPassword) {
          errorText.textContent = 'Les mots de passe ne correspondent pas';
          errorMessage.classList.remove('hidden');
          return;
        }
        
        // Préparer les données
        const formData = {
          username,
          email,
          password,
          confirmPassword
        };
        
        // Masquer les messages d'erreur précédents
        errorMessage.classList.add('hidden');
        
        // Construire l'URL complète
        const registerUrl = `${apiUrl}/auth/register`;
        
        showPopup('info', 'Inscription en cours...', 'Votre inscription est en cours de réalisation. Veuillez patienter.', 2000);
        // Envoyer la requête avec Axios
        axios.post(registerUrl, formData)
          .then(function(response) {
            if (response.data.success) {
              showPopup('success', 'Succès', 'Votre inscription a été réalisée avec succès. Vous allez être redirigé vers la page de connexion.', 4000);
              // Stocker le token dans le localStorage
              localStorage.setItem('token', response.data.token);
              // Redirection vers la page de connexion avec message de succès
              setTimeout(() => {
                window.location.href = '/auth/login';
              }, 4000);
            } else {
              // Afficher l'erreur
              errorText.textContent = response.data.message || 'Une erreur est survenue';
              showPopup('error', 'Erreur', errorText.textContent, 4000);

              errorMessage.classList.remove('hidden');
            }
          })
          .catch(function(error) {
            console.error('Erreur:', error);
            console.log(error.status);
            if (error.status === 409) {
              showPopup('warning', 'Inscription refusée', 'Un compte avec cet email ou ce nom d\'utilisateur existe déjà.', 4000);
            } else if (error.status === 400) {
              showPopup('error', 'Erreur', 'Une erreur est survenue lors de l\'inscription', 4000);
            } else {
              showPopup('error', 'Erreur', 'Une erreur est survenue lors de l\'inscription', 4000);
            }
          });
      });
    });