doctype html
html(lang='fr')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title= title || appName
    
    //- Favicon
    link(rel='shortcut icon', href=asset('images/luma/luma75.png'), type='image/x-icon')
    
    //- CSS global
    link(rel='stylesheet', href=asset('css/global/main.css'))
    link(rel='stylesheet', href=asset('css/global/popup.css'))
    link(rel='stylesheet', href=asset('css/global/theme.css'))
    link(rel='stylesheet', href=asset('css/global/dashboard-header.css'))

    
    //- CSS fontawesome
    link(rel='stylesheet', href=asset('fontawesome/css/all.css'))
    
    //- CSS layout
    link(rel='stylesheet', href=asset('css/layouts/header.css'))
    link(rel='stylesheet', href=asset('css/layouts/footer.css'))
    
    //- Admin sidebar CSS
    if user && user.role === 'admin'
      link(rel='stylesheet', href=asset('css/admin-sidebar.css'))
    
    //- CSS spécifiques à la page
    if pageStyles
      each style in pageStyles
        link(rel='stylesheet', href=asset(style))
    
    //- JavaScript libraries
    script(src=asset('js/lib/axios.js'))
    script(src=asset('js/lib/jquery.js'))
    script(src=asset('js/lib/popup.js'))
    
    //- Script pour exposer les variables d'environnement frontend  
    script.
      window.API_URL = '#{apiUrl}';
      window.USER_ROLE = '#{user ? user.role : ""}';
      window.USER_ID = '#{user ? user.id : ""}';
    
    //- Service Axios centralisé
    script(src=asset('js/api/axios-service.js'))

    //- Auth Manager uniquement si l'utilisateur est déjà connecté (pas sur la page login)
    if user
      script(src=asset('js/auth/auth-manager.js'))
        
  body
    //- Header
    include ../partials/header
    
    //- Admin Sidebar (if user is admin)
    if user && user.role === 'admin'
      include ../partials/admin-sidebar
    
    //- Flash Messages
    if error
      .alert.alert-danger= error
    
    if success
      .alert.alert-success= success
    
    //- Main Content
    main.main-content
      block content
    
    //- Footer
    include ../partials/footer
    
    //- JavaScript global
    script(src=asset('js/main.js'))
    
    //- Admin sidebar JS
    if user && user.role === 'admin'
      script(src=asset('js/admin-sidebar.js'))
    
    //- JavaScript spécifiques à la page
    if pageScripts
      each script in pageScripts
        script(src=asset(script))
    
    //- Bloc pour les scripts additionnels
    block scripts 

    //- Bouton de débogage et modal
    if user
      link(rel='stylesheet', href=asset('css/debug/debug.css'))
      button#debug-button.debug-button(title="Signaler un bug") 🐛
      #debug-modal.debug-modal
        .debug-modal-content
          span.debug-modal-close &times;
          h2 Signaler un bug
          form.debug-form
            .form-group
              label(for="title") Titre
              input#title.form-control(type="text" name="title" required)
            .form-group
              label(for="description") Description
              textarea#description.form-control(name="description" required)
            .form-group
              label(for="priority") Priorité
              select#priority(name="priority" required)
                option(value="basse") Basse
                option(value="moyenne" selected) Moyenne
                option(value="elevee") Élevée
                option(value="critique") Critique
            .form-group.image-upload
              label(for="image-upload") Images
              input#image-upload(type="file" name="images" accept="image/*" multiple)
              .paste-zone
                p Collez une image ici (Ctrl+V)
              #image-preview

            button.btn.btn-primary(type="submit") Envoyer

      //- Scripts de débogage avec dépendances
      script(src=asset('js/lib/axios-config.js'))
      script(src=asset('js/debug/debug-manager.js')) 