extends ../layouts/nino

block styles
  link(rel='stylesheet', href='/assets/css/nino/nino.css')
  link(rel='stylesheet', href='/assets/css/nino/components.css')
  link(rel='stylesheet', href='/assets/css/nino/animations.css')
  
block content
  // Contenu spécifique à Nino
  style.
    /* Style pour cacher le header et le footer Luma */
    body {
      background-color: var(--bg-dark);
      color: var(--text-dark);
    }
    header.header, footer.footer, .sidebar {
      display: none !important;
    }
    .main-content {
      padding: 0 !important;
      margin: 0 !important;
      width: 100%;
    }

  // Début du contenu Nino
  .nino-body
    // Section Vidéo en vedette
    section.nino-hero(style="background-image: url('https://source.unsplash.com/random/1920x1080/?skateboard')")
      .nino-hero-content
        h1.nino-hero-title Basic how to ride your skateboard comfortly and Basic Equipment to play skateboard safely
        p.nino-hero-description Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
        .nino-hero-buttons
          button.nino-btn.nino-btn-primary
            i.fas.fa-play
            | Regarder
          button.nino-btn.nino-btn-secondary
            i.fas.fa-plus
            | Ajouter à ma liste

    // Section Shorts
    section.nino-section
      .nino-container
        .nino-section-header
          h2.nino-section-title Shorts
          a.nino-see-all(href="/nino/shorts") Voir tout
        
        .nino-shorts-row
          - for (let i = 1; i <= 6; i++)
            .nino-short-card
              .nino-short-image
                img(src=`https://source.unsplash.com/random/400x600/?skateboard,trick,${i}`, alt=`Short ${i}`)
                .nino-short-overlay
                  button.nino-play-button
                    i.fas.fa-play
                .nino-short-info
                  h3.nino-short-title Trick rapide ##{i}
                  .nino-short-meta
                    span.nino-short-views #{Math.floor(Math.random() * 900 + 100)}K vues
                    span.nino-short-duration 0:#{Math.floor(Math.random() * 40 + 20)}

    // Section Musiques
    section.nino-section
      .nino-container
        .nino-section-header
          h2.nino-section-title Musiques
          a.nino-see-all(href="/nino/music") Voir tout
        
        .nino-music-row
          - for (let i = 1; i <= 6; i++)
            .nino-music-card
              .nino-music-image
                img(src=`https://source.unsplash.com/random/300x300/?music,album,${i}`, alt=`Music ${i}`)
                .nino-music-overlay
                  button.nino-play-button
                    i.fas.fa-play
              .nino-music-content
                h3.nino-music-title Skateboard Mix ##{i}
                p.nino-music-artist Artiste #{i}
                .nino-music-meta
                  span.nino-music-duration #{Math.floor(Math.random() * 2 + 2)}:#{Math.floor(Math.random() * 60).toString().padStart(2, '0')}
                  span.nino-music-plays #{Math.floor(Math.random() * 900 + 100)}K écoutes

    // Section Vidéos Populaires
    section.nino-section
      .nino-container
        .nino-section-header
          h2.nino-section-title Vidéos populaires
          a.nino-see-all(href="/nino/popular") Voir tout
        
        .nino-row
          // Cartes vidéo
          - for (let i = 1; i <= 8; i++)
            .nino-card
              .nino-card-image
                img(src=`https://source.unsplash.com/random/400x225/?skateboard,${i}`, alt=`Vidéo ${i}`)
                .nino-card-overlay
                  button.nino-play-button
                    i.fas.fa-play
              h3.nino-card-title Les bases du skateboard - Partie #{i}
              .nino-card-meta
                span.nino-card-duration 15:30
                span.nino-card-views 125,908 vues

    // Section Continuer à regarder
    section.nino-section
      .nino-container
        .nino-section-header
          h2.nino-section-title Continuer à regarder
          a.nino-see-all(href="/nino/history") Voir tout
        
        .nino-row
          // Cartes vidéo
          - for (let i = 3; i <= 7; i++)
            .nino-card
              .nino-card-image
                img(src=`https://source.unsplash.com/random/400x225/?skateboard,trick,${i}`, alt=`Continuer ${i}`)
                .nino-card-overlay
                  button.nino-play-button
                    i.fas.fa-play
                .nino-progress
                  .nino-progress-bar(style=`width: ${Math.floor(Math.random() * 95)}%`)
              h3.nino-card-title Trucs et astuces - Épisode #{i}
              .nino-card-meta
                span.nino-card-duration 22:45
                span.nino-card-views 87,542 vues

    // Section Chat en direct
    section.nino-section
      .nino-container
        .nino-section-header
          h2.nino-section-title Diffusions en direct
          a.nino-see-all(href="/nino/live") Voir tout
        
        .nino-live-container
          .nino-live-video
            img(src="https://source.unsplash.com/random/800x450/?skateboard,live", alt="Live Stream")
            .nino-live-badge
              i.fas.fa-circle
              | LIVE
            .nino-live-overlay
              button.nino-live-button
                i.fas.fa-play
                | Rejoindre
            .nino-live-info
              h3 Andy William - Les bases du skateboard
              p 1,980,893 abonnés • 125,908 spectateurs
          
          .nino-live-chat
            h3.nino-chat-header
              | Live Chat
              span.nino-chat-count 16,588 personnes
            
            .nino-chat-messages
              .nino-chat-message
                img.nino-chat-avatar(src="https://i.pravatar.cc/150?img=2", alt="Avatar")
                .nino-chat-content
                  .nino-chat-user Wijaya Abadi
                  .nino-chat-text Duis aute irure dolor in in reprehenderit velit esse cillum dolore eu fugiat
              
              .nino-chat-message
                img.nino-chat-avatar(src="https://i.pravatar.cc/150?img=3", alt="Avatar")
                .nino-chat-content
                  .nino-chat-user Johny Wise
                  .nino-chat-text tempor incididunt ut labore
              
              .nino-chat-message
                img.nino-chat-avatar(src="https://i.pravatar.cc/150?img=4", alt="Avatar")
                .nino-chat-content
                  .nino-chat-user Budi Hakim
                  .nino-chat-text Duis aute irure dolor in in reprehenderit velit esse cillum dolore eu fugiat
              
              .nino-chat-message
                img.nino-chat-avatar(src="https://i.pravatar.cc/150?img=5", alt="Avatar")
                .nino-chat-content
                  .nino-chat-user Thomas Hope
                  .nino-chat-text velit esse cillum dolore eu fugiat
            
            .nino-chat-input
              input(type="text", placeholder="Écrire un message...")
              button.nino-chat-send
                i.fas.fa-paper-plane

    // Section Vidéos Recommandées
    section.nino-section
      .nino-container
        .nino-section-header
          h2.nino-section-title Recommandé pour vous
          a.nino-see-all(href="/nino/recommended") Voir tout
        
        .nino-row
          // Cartes vidéo recommandées
          .nino-card
            .nino-card-image
              img(src="https://source.unsplash.com/random/400x225/?skateboard,jump", alt="Recommandé 1")
              .nino-card-overlay
                button.nino-play-button
                  i.fas.fa-play
            h3.nino-card-title Préparez-vous pour votre premier saut en skateboard
            .nino-card-meta
              span.nino-card-author Jordan Wise
              span.nino-card-views 125,908 vues • il y a 2 jours
          
          .nino-card
            .nino-card-image
              img(src="https://source.unsplash.com/random/400x225/?skateboard,ramp", alt="Recommandé 2")
              .nino-card-overlay
                button.nino-play-button
                  i.fas.fa-play
            h3.nino-card-title Conseils pour faire du skateboard sur une rampe
            .nino-card-meta
              span.nino-card-author Jordan Wise
              span.nino-card-views 125,908 vues • il y a 2 jours

block scripts
  script(src="/assets/js/lib/jquery.js")
  script(src="/assets/js/lib/axios.js")
  script(src="/assets/js/lib/popup.js")
  script(src="/assets/js/nino/nino.js") 