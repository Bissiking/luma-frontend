extends ../layouts/nino

block styles
    link(rel='stylesheet', href='/assets/css/nino/video-player.css')

block content
    .nino-video-page
        #video-player.nino-video-container
        
        .nino-video-info
            h1.nino-video-title= video.title
            .nino-video-meta
                span.nino-video-views
                    i.fas.fa-eye
                    | #{video.views} vues
                span.nino-video-date
                    i.fas.fa-calendar
                    | #{video.uploadDate}
                span.nino-video-author
                    i.fas.fa-user
                    | #{video.author}
            
            .nino-video-actions
                button.nino-btn.nino-btn-secondary
                    i.fas.fa-thumbs-up
                    | #{video.likes}
                button.nino-btn.nino-btn-secondary
                    i.fas.fa-thumbs-down
                    | #{video.dislikes}
                button.nino-btn.nino-btn-secondary
                    i.fas.fa-share
                    | Partager
                button.nino-btn.nino-btn-secondary
                    i.fas.fa-plus
                    | Ajouter à ma liste
            
            .nino-video-description
                p= video.description
            
            .nino-video-tags
                each tag in video.tags
                    span.nino-tag= tag

block scripts
    script(src='/assets/js/nino/video-player.js')
    script.
        // Initialisation du lecteur vidéo
        document.addEventListener('DOMContentLoaded', function() {
            const player = new NinoVideoPlayer('video-player', '#{video.id}', {
                autoplay: true,
                quality: 'auto'
            });
        }); 