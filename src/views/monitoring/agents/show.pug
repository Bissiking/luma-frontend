extends ../../layouts/main

block content
  .dashboard-page
    .container-fluid
      .dashboard-header.mb-4
        .header-content
          h1.dashboard-title.d-flex.align-items-center.gap-2
            i.fas.fa-server.gradient-icon
            | Agent: 
            span#agent-name Chargement...
          nav(aria-label="breadcrumb")
            ol.breadcrumb.mb-0
              li.breadcrumb-item
                a(href="/dashboard") Tableau de bord
              li.breadcrumb-item
                a(href="/monitoring/agents") Agents de supervision
              li.breadcrumb-item.active(aria-current="page") Détail de l'agent
            
      .row
        .col-md-3.mb-4
          .card
            .card-header.d-flex.justify-content-between.align-items-center
              h5.mb-0 Informations
              button.btn.btn-sm.btn-primary.edit-agent-btn(type="button")
                i.fas.fa-edit
            .card-body
              .info-item
                .info-label ID
                .info-value#agent-id -
              .info-item
                .info-label Statut
                .info-value#agent-status
                  span.badge.bg-secondary Chargement...
              .info-item
                .info-label Type
                .info-value#agent-type -
              .info-item
                .info-label UUID
                .info-value#agent-uuid -
              .info-item
                .info-label IP
                .info-value#agent-ip -
              .info-item
                .info-label Dernière connexion
                .info-value#agent-last-check -
              .info-item
                .info-label Version
                .info-value#agent-version -
              .info-item
                .info-label Créé le
                .info-value#agent-created -

          .card.mt-4
            .card-header.d-flex.justify-content-between.align-items-center
              h5.mb-0 Utilisateurs autorisés
              button.btn.btn-sm.btn-primary#add-user-btn(type="button" data-bs-toggle="modal" data-bs-target="#add-user-modal")
                i.fas.fa-plus.me-1
                | Ajouter
            .card-body
              .table-responsive
                table.table.table-sm#users-table
                  thead
                    tr
                      th Utilisateur
                      th Rôle
                      th Actions
                  tbody
                    // Données chargées dynamiquement
                    tr.placeholder-glow
                      td(colspan="3").text-center
                        span.placeholder.col-12 Chargement...
              
        .col-md-9
          // Onglets
          ul.nav.nav-tabs.mb-4#agent-tabs(role="tablist")
            li.nav-item(role="presentation")
              button.nav-link.active#metrics-tab(data-bs-toggle="tab" data-bs-target="#metrics-panel" type="button" role="tab" aria-controls="metrics-panel" aria-selected="true")
                i.fas.fa-chart-line.me-2
                | Métriques
            li.nav-item(role="presentation")
              button.nav-link#services-tab(data-bs-toggle="tab" data-bs-target="#services-panel" type="button" role="tab" aria-controls="services-panel" aria-selected="false")
                i.fas.fa-cogs.me-2
                | Services
            li.nav-item(role="presentation")
              button.nav-link#config-tab(data-bs-toggle="tab" data-bs-target="#config-panel" type="button" role="tab" aria-controls="config-panel" aria-selected="false")
                i.fas.fa-wrench.me-2
                | Configuration
            li.nav-item(role="presentation")
              button.nav-link#alerts-tab(data-bs-toggle="tab" data-bs-target="#alerts-panel" type="button" role="tab" aria-controls="alerts-panel" aria-selected="false")
                i.fas.fa-bell.me-2
                | Alertes
                span.badge.bg-danger.ms-1#alerts-count 0
          
          // Contenu des onglets
          .tab-content
            // Métriques
            .tab-pane.fade.show.active#metrics-panel(role="tabpanel" aria-labelledby="metrics-tab")
              .card
                .card-header
                  .d-flex.justify-content-between.align-items-center
                    h5.mb-0 Métriques
                    .btn-group
                      button.btn.btn-sm.btn-outline-secondary.active#metrics-hour 1h
                      button.btn.btn-sm.btn-outline-secondary#metrics-day 24h
                      button.btn.btn-sm.btn-outline-secondary#metrics-week 7j
                .card-body
                  .row
                    .col-md-6.mb-4
                      .metric-card
                        h6.metric-title 
                          i.fas.fa-microchip.me-2
                          | CPU
                        .metric-chart#cpu-chart
                          .placeholder-glow
                            span.placeholder.col-12
                    .col-md-6.mb-4
                      .metric-card
                        h6.metric-title
                          i.fas.fa-memory.me-2
                          | Mémoire
                        .metric-chart#memory-chart
                          .placeholder-glow
                            span.placeholder.col-12
                    .col-md-6.mb-4
                      .metric-card
                        h6.metric-title
                          i.fas.fa-hdd.me-2
                          | Disque
                        .metric-chart#disk-chart
                          .placeholder-glow
                            span.placeholder.col-12
                    .col-md-6.mb-4
                      .metric-card
                        h6.metric-title
                          i.fas.fa-network-wired.me-2
                          | Réseau
                        .metric-chart#network-chart
                          .placeholder-glow
                            span.placeholder.col-12
            
            // Services
            .tab-pane.fade#services-panel(role="tabpanel" aria-labelledby="services-tab")
              .card
                .card-header
                  .d-flex.justify-content-between.align-items-center
                    h5.mb-0 Services
                    .btn-group
                      button.btn.btn-sm.btn-outline-secondary.active#services-all Tous
                      button.btn.btn-sm.btn-outline-secondary#services-windows Windows
                      button.btn.btn-sm.btn-outline-secondary#services-linux Linux
                      button.btn.btn-sm.btn-outline-secondary#services-docker Docker
                .card-body
                  .table-responsive
                    table.table.table-striped#services-table
                      thead
                        tr
                          th Type
                          th Nom
                          th État
                          th Surveiller
                          th Actions
                      tbody
                        // Données chargées dynamiquement
                        tr.placeholder-glow
                          td(colspan="5").text-center
                            span.placeholder.col-12 Chargement des services...
            
            // Configuration
            .tab-pane.fade#config-panel(role="tabpanel" aria-labelledby="config-tab")
              .card
                .card-header
                  h5.mb-0 Configuration de l'agent
                .card-body
                  form#config-form
                    h6.mb-3 Paramètres généraux
                    .row
                      .col-md-6.mb-3
                        label.form-label(for="interval") Intervalle de collecte (secondes)
                        input.form-control#interval(type="number" min="10" max="3600")
                      .col-md-6.mb-3
                        label.form-label(for="log-level") Niveau de logs
                        select.form-select#log-level
                          option(value="DEBUG") DEBUG
                          option(value="INFO") INFO
                          option(value="WARNING") WARNING
                          option(value="ERROR") ERROR
                    
                    .mb-4
                      .form-check.form-switch
                        input.form-check-input#alerts-enabled(type="checkbox")
                        label.form-check-label(for="alerts-enabled") Activer les alertes
                    
                    h6.mb-3 Collecteurs
                    
                    // CPU
                    .collector-section.mb-4
                      .collector-header.d-flex.align-items-center.justify-content-between.mb-2
                        h6.mb-0 
                          i.fas.fa-microchip.me-2
                          | CPU
                        .form-check.form-switch
                          input.form-check-input#cpu-collector-enabled(type="checkbox")
                          label.form-check-label(for="cpu-collector-enabled") Activer
                      
                      .collector-body
                        .row
                          .col-md-6.mb-3
                            label.form-label(for="cpu-warning") Seuil d'avertissement (%)
                            input.form-control#cpu-warning(type="number" min="0" max="100")
                          .col-md-6.mb-3
                            label.form-label(for="cpu-critical") Seuil critique (%)
                            input.form-control#cpu-critical(type="number" min="0" max="100")
                    
                    // Mémoire
                    .collector-section.mb-4
                      .collector-header.d-flex.align-items-center.justify-content-between.mb-2
                        h6.mb-0 
                          i.fas.fa-memory.me-2
                          | Mémoire
                        .form-check.form-switch
                          input.form-check-input#memory-collector-enabled(type="checkbox")
                          label.form-check-label(for="memory-collector-enabled") Activer
                      
                      .collector-body
                        .row
                          .col-md-6.mb-3
                            label.form-label(for="memory-warning") Seuil d'avertissement (%)
                            input.form-control#memory-warning(type="number" min="0" max="100")
                          .col-md-6.mb-3
                            label.form-label(for="memory-critical") Seuil critique (%)
                            input.form-control#memory-critical(type="number" min="0" max="100")
                    
                    // Disque
                    .collector-section.mb-4
                      .collector-header.d-flex.align-items-center.justify-content-between.mb-2
                        h6.mb-0 
                          i.fas.fa-hdd.me-2
                          | Disque
                        .form-check.form-switch
                          input.form-check-input#disk-collector-enabled(type="checkbox")
                          label.form-check-label(for="disk-collector-enabled") Activer
                      
                      .collector-body
                        .row
                          .col-md-6.mb-3
                            label.form-label(for="disk-warning") Seuil d'avertissement (%)
                            input.form-control#disk-warning(type="number" min="0" max="100")
                          .col-md-6.mb-3
                            label.form-label(for="disk-critical") Seuil critique (%)
                            input.form-control#disk-critical(type="number" min="0" max="100")
                    
                    // Réseau
                    .collector-section.mb-4
                      .collector-header.d-flex.align-items-center.justify-content-between.mb-2
                        h6.mb-0 
                          i.fas.fa-network-wired.me-2
                          | Réseau
                        .form-check.form-switch
                          input.form-check-input#network-collector-enabled(type="checkbox")
                          label.form-check-label(for="network-collector-enabled") Activer
                      
                      .collector-body
                        .row
                          .col-md-6.mb-3
                            label.form-label(for="network-warning") Seuil d'avertissement (%)
                            input.form-control#network-warning(type="number" min="0" max="100")
                          .col-md-6.mb-3
                            label.form-label(for="network-critical") Seuil critique (%)
                            input.form-control#network-critical(type="number" min="0" max="100")
                    
                    // Docker
                    .collector-section.mb-4
                      .collector-header.d-flex.align-items-center.justify-content-between.mb-2
                        h6.mb-0 
                          i.fab.fa-docker.me-2
                          | Docker
                        .form-check.form-switch
                          input.form-check-input#docker-collector-enabled(type="checkbox")
                          label.form-check-label(for="docker-collector-enabled") Activer
                      
                      .collector-body
                        .row
                          .col-md-6.mb-3
                            label.form-label(for="docker-warning") Seuil d'avertissement (%)
                            input.form-control#docker-warning(type="number" min="0" max="100")
                          .col-md-6.mb-3
                            label.form-label(for="docker-critical") Seuil critique (%)
                            input.form-control#docker-critical(type="number" min="0" max="100")
                    
                    // Notifications
                    h6.mb-3 Notifications
                    
                    .mb-3
                      label.form-label(for="notification-email") Email
                      input.form-control#notification-email(type="email")
                    
                    .mb-3
                      label.form-label(for="notification-discord") Webhook Discord
                      input.form-control#notification-discord(type="text")
                    
                    .mb-3
                      label.form-label(for="notification-slack") Webhook Slack
                      input.form-control#notification-slack(type="text")
                    
                    .text-end
                      button.btn.btn-primary#save-config-btn(type="button")
                        i.fas.fa-save.me-2
                        | Enregistrer
            
            // Alertes
            .tab-pane.fade#alerts-panel(role="tabpanel" aria-labelledby="alerts-tab")
              .card
                .card-header
                  h5.mb-0 Alertes
                .card-body
                  .table-responsive
                    table.table.table-striped#alerts-table
                      thead
                        tr
                          th Date
                          th Type
                          th Message
                          th Valeur
                          th Seuil
                          th État
                          th Actions
                      tbody
                        // Données chargées dynamiquement
                        tr.placeholder-glow
                          td(colspan="7").text-center
                            span.placeholder.col-12 Chargement des alertes...
  
  // Modal pour ajouter un utilisateur
  .modal.fade#add-user-modal(tabindex="-1" aria-labelledby="add-user-modal-label" aria-hidden="true")
    .modal-dialog
      .modal-content
        .modal-header
          h5.modal-title#add-user-modal-label Ajouter un utilisateur
          button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Fermer")
        .modal-body
          form#add-user-form
            .mb-3
              label.form-label(for="user-select") Utilisateur
              select.form-select#user-select(required)
                option(value="") Sélectionner un utilisateur
                // Options chargées dynamiquement
            
            .mb-3
              label.form-label(for="user-role") Rôle
              select.form-select#user-role
                option(value="viewer" selected) Lecture seule (viewer)
                option(value="editor") Éditeur (editor)
                option(value="admin") Administrateur (admin)
        .modal-footer
          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Annuler
          button.btn.btn-primary#add-user-submit(type="button") Ajouter

  // Template pour les actions utilisateur
  template#user-actions-template
    .d-flex.gap-1
      button.btn.btn-sm.btn-danger.remove-user(type="button" title="Supprimer")
        i.fas.fa-trash

  // Template pour les actions de service
  template#service-actions-template
    .d-flex.gap-1
      button.btn.btn-sm.btn-info.configure-service(type="button" title="Configurer")
        i.fas.fa-cog

  // Template pour les actions d'alerte
  template#alert-actions-template
    .d-flex.gap-1
      button.btn.btn-sm.btn-primary.acknowledge-alert(type="button" title="Acquitter")
        i.fas.fa-check

block scripts
  script(src='https://cdn.jsdelivr.net/npm/chart.js') 