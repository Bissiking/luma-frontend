extends ../../layouts/main

block scripts
  // Charger la configuration Axios en premier
  script(src="/assets/js/api/axios-config.js")
  script(src="/assets/js/agents-management.js" defer)
  //- script(src="/assets/js/monitoring/agents-list-simple.js" defer)

block content
  .dashboard-page
    .container-fluid
      .dashboard-header.mb-4
        .header-content
          h1.dashboard-title.d-flex.align-items-center.gap-2
            i.fas.fa-server.gradient-icon
            | Gestion des Agents
          nav(aria-label="breadcrumb")
            ol.breadcrumb.mb-0
              li.breadcrumb-item
                a(href="/dashboard") Tableau de bord
              li.breadcrumb-item.active(aria-current="page") Gestion des Agents
            
      .view-controls.mb-4
        .view-actions
          button.btn-primary.create-agent-btn#create-agent-btn
            i.fas.fa-plus
            span Nouvel Agent
          
          button.btn-secondary.refresh-btn#refresh-agents
            i.fas.fa-sync-alt
            span Rafraîchir
            
        .view-options
          .search-container
            input(type="text" placeholder="Rechercher un agent..." id="agent-search")
            i.fas.fa-search
          
          .view-switch
            button.btn-icon.list-view-btn.active#list-view-btn(title="Vue liste")
              i.fas.fa-list
            button.btn-icon.grid-view-btn#grid-view-btn(title="Vue grille") 
              i.fas.fa-th-large
          
          .filter-dropdown
            button.btn-secondary.dropdown-toggle#filter-toggle
              i.fas.fa-filter
              span Filtrer
            .dropdown-menu#filter-menu
              .dropdown-item
                input(type="checkbox" id="filter-status-online" checked)
                label(for="filter-status-online") En ligne
              .dropdown-item
                input(type="checkbox" id="filter-status-offline" checked)
                label(for="filter-status-offline") Hors ligne
              .dropdown-item
                input(type="checkbox" id="filter-status-warning" checked)
                label(for="filter-status-warning") Avertissement
              .dropdown-item
                input(type="checkbox" id="filter-status-error" checked)
                label(for="filter-status-error") Erreur
              .dropdown-item.divider
              .dropdown-item
                input(type="checkbox" id="filter-type-linux" checked)
                label(for="filter-type-linux") Linux
              .dropdown-item
                input(type="checkbox" id="filter-type-windows" checked)
                label(for="filter-type-windows") Windows
              .dropdown-item.divider
              .dropdown-item
                input(type="checkbox" id="filter-type-arkos" checked)
                label(for="filter-type-arkos") ARKOS Agent
              .dropdown-item.divider
              button.btn-primary#apply-filters Appliquer
      
      .agents-container
        .agents-view.list-view#agents-view
          .agents-header
            .agent-header-name
              span Nom
              button.sort-btn(data-sort="name")
                i.fas.fa-sort
            .agent-header-version
              span Version
              button.sort-btn(data-sort="version")
                i.fas.fa-sort
            .agent-header-status 
              span Statut
              button.sort-btn(data-sort="status")
                i.fas.fa-sort
            .agent-header-metrics Métriques
            .agent-header-last-seen
              span Dernière activité
              button.sort-btn(data-sort="lastSeen")
                i.fas.fa-sort
            .agent-header-actions
              span Actions

          .agents-loading#agents-loading
            i.fas.fa-spinner.fa-spin
            span Chargement des agents...
          
          .agents-list#agents-list
            // Les agents seront ajoutés ici dynamiquement
            
          .agents-empty#agents-empty.hidden
            i.fas.fa-server
            p Aucun agent trouvé
      
      .pagination-container#pagination-container
        button.pagination-prev#pagination-prev
          i.fas.fa-chevron-left
        .pagination-pages#pagination-pages
          // Les pages seront ajoutées ici dynamiquement
        button.pagination-next#pagination-next
          i.fas.fa-chevron-right
      
  // Modal de création d'agent
  .modal#create-agent-modal
    .modal-content
      .modal-header
        h3 Nouvel Agent
        button.close-btn#close-create-modal
          i.fas.fa-times
      .modal-body
        form#create-agent-form
          .form-group
            label(for="agent-name") Nom de l'agent
            input(type="text" id="agent-name" required)
          
          .form-group
            label(for="agent-type") Type
            select#agent-type
              option(value="linux") Linux
              option(value="windows") Windows
              option(value="arkos") ARKOS Agent
          
          .form-group.linux-windows-fields
            label(for="agent-description") Description
            textarea#agent-description
          
          .form-group.linux-windows-fields
            .checkbox-container
              input(type="checkbox" id="agent-public")
              label(for="agent-public") Agent public

          .form-group.arkos-fields.hidden
            label(for="agent-api-key") Clé API
            .input-group
              input(type="text" id="agent-api-key" readonly)
              button.btn-secondary.copy-btn(type="button" data-clipboard="agent-api-key")
                i.fas.fa-copy
          
          .form-group.arkos-fields.hidden
            label(for="agent-token") Token
            .input-group
              input(type="text" id="agent-token" readonly)
              button.btn-secondary.copy-btn(type="button" data-clipboard="agent-token")
                i.fas.fa-copy
          
          .form-group.arkos-fields.hidden
            label(for="agent-status") Statut
            .status-badge.pending
              i.fas.fa-clock
              span En attente d'activation
      
      .modal-footer
        button.btn-secondary#cancel-create-agent Annuler
        button.btn-primary#create-agent-submit Créer
  
  // Modal de suppression d'agent
  .modal#delete-agent-modal
    .modal-content
      .modal-header
        h3 Supprimer l'agent
        button.close-btn#close-delete-modal
          i.fas.fa-times
      .modal-body
        p Êtes-vous sûr de vouloir supprimer l'agent 
          span#delete-agent-name
          | ?
        input(type="hidden" id="delete-agent-id")
      
      .modal-footer
        button.btn-secondary#cancel-delete-agent Annuler
        button.btn-danger#delete-agent-confirm Supprimer 