extends ../../layouts/main

block content
  .monitoring-dashboard
    .container-fluid
      .dashboard-header.mb-3
        .header-content
          h1.dashboard-title.d-flex.align-items-center.gap-2
            i.fas.fa-bell.gradient-icon
            | Alertes de supervision
          nav(aria-label="breadcrumb")
            ol.breadcrumb.mb-0
              li.breadcrumb-item
                a(href="/dashboard") Tableau de bord
              li.breadcrumb-item
                a(href="/monitoring") Supervision
              li.breadcrumb-item.active(aria-current="page") Alertes
      
      // Vue d'ensemble des alertes
      .row.mb-3
        .col-lg-3.col-md-6.mb-2
          .status-card.bg-gradient-primary
            .status-icon
              i.fas.fa-bell
            .status-content
              h3.status-value#total-alerts 14
              p.status-label Total des alertes
                  
        .col-lg-3.col-md-6.mb-2
          .status-card.bg-gradient-success
            .status-icon
              i.fas.fa-check-circle
            .status-content
              h3.status-value#resolved-alerts 5
              p.status-label Résolues
                  
        .col-lg-3.col-md-6.mb-2
          .status-card.bg-gradient-warning
            .status-icon
              i.fas.fa-check
            .status-content
              h3.status-value#ack-alerts 6
              p.status-label Acquittées
                  
        .col-lg-3.col-md-6.mb-2
          .status-card.bg-gradient-danger
            .status-icon
              i.fas.fa-exclamation-circle
            .status-content
              h3.status-value#active-alerts 3
              p.status-label Actives
      
      // Onglets des alertes
      .card.dashboard-card.mb-3
        .card-header.bg-light
          ul.nav.nav-tabs.card-header-tabs
            li.nav-item
              a.nav-link.active(href="#active-alerts-tab", data-bs-toggle="tab") 
                i.fas.fa-exclamation-circle.me-1.text-danger
                | Actives 
                span.badge.bg-danger.ms-1 3
            li.nav-item
              a.nav-link(href="#acknowledged-alerts-tab", data-bs-toggle="tab") 
                i.fas.fa-check.me-1.text-warning
                | Acquittées 
                span.badge.bg-warning.ms-1 6
            li.nav-item
              a.nav-link(href="#resolved-alerts-tab", data-bs-toggle="tab") 
                i.fas.fa-check-circle.me-1.text-success
                | Résolues 
                span.badge.bg-success.ms-1 5
        
        .card-body.p-0
          .tab-content
            // Alertes actives
            #active-alerts-tab.tab-pane.fade.show.active
              // Filtres
              .alert-filters.p-3.border-bottom
                form.row.g-3#active-alerts-filter-form
                  .col-md-3
                    label.form-label.small(for="active-severity-filter") Sévérité
                    select.form-select.form-select-sm#active-severity-filter
                      option(value="") Toutes
                      option(value="critical") Critique
                      option(value="warning") Avertissement
                      option(value="info") Information
                  
                  .col-md-3
                    label.form-label.small(for="active-agent-filter") Agent
                    select.form-select.form-select-sm#active-agent-filter
                      option(value="") Tous
                      // Options chargées dynamiquement
                  
                  .col-md-3
                    label.form-label.small(for="active-date-filter") Période
                    select.form-select.form-select-sm#active-date-filter
                      option(value="24h") Dernières 24h
                      option(value="7d") 7 derniers jours
                      option(value="30d") 30 derniers jours
                  
                  .col-md-3.d-flex.align-items-end
                    button.btn.btn-sm.btn-primary.w-100(type="submit")
                      i.fas.fa-filter.me-1
                      | Filtrer
              
              // Tableau d'alertes actives
              .table-responsive
                table.table.table-hover.table-sm.mb-0#active-alerts-table
                  thead
                    tr
                      th Date
                      th Agent
                      th Sévérité
                      th Message
                      th Actions
                  tbody
                    // Données fictives pour la mise en page
                    tr
                      td 2023-05-15 11:42
                      td srv-db01
                      td 
                        span.badge.bg-danger Critique
                      td SGBD PostgreSQL - CPU usage > 90%
                      td
                        .btn-group.btn-group-sm
                          button.btn.btn-outline-info(title="Détails")
                            i.fas.fa-eye
                          button.btn.btn-outline-warning(title="Acquitter")
                            i.fas.fa-check
                    tr
                      td 2023-05-15 11:38
                      td srv-app02
                      td
                        span.badge.bg-warning Avertissement
                      td Service Nginx - Latence > 2s
                      td
                        .btn-group.btn-group-sm
                          button.btn.btn-outline-info(title="Détails")
                            i.fas.fa-eye
                          button.btn.btn-outline-warning(title="Acquitter")
                            i.fas.fa-check
                    tr
                      td 2023-05-15 11:15
                      td srv-app01
                      td
                        span.badge.bg-danger Critique
                      td Service PHP-FPM - Stopped
                      td
                        .btn-group.btn-group-sm
                          button.btn.btn-outline-info(title="Détails")
                            i.fas.fa-eye
                          button.btn.btn-outline-warning(title="Acquitter")
                            i.fas.fa-check
            
            // Alertes acquittées
            #acknowledged-alerts-tab.tab-pane.fade
              // Filtres
              .alert-filters.p-3.border-bottom
                form.row.g-3#ack-alerts-filter-form
                  .col-md-4
                    label.form-label.small(for="ack-ticket-filter") Ticket
                    select.form-select.form-select-sm#ack-ticket-filter
                      option(value="") Tous
                      option(value="with-ticket") Avec ticket
                      option(value="without-ticket") Sans ticket
                  
                  .col-md-4
                    label.form-label.small(for="ack-agent-filter") Agent
                    select.form-select.form-select-sm#ack-agent-filter
                      option(value="") Tous
                      // Options chargées dynamiquement
                  
                  .col-md-4
                    label.form-label.small(for="ack-user-filter") Acquitté par
                    select.form-select.form-select-sm#ack-user-filter
                      option(value="") Tous
                      // Options chargées dynamiquement
              
              // Tableau d'alertes acquittées
              .table-responsive
                table.table.table-hover.table-sm.mb-0#acknowledged-alerts-table
                  thead
                    tr
                      th Date
                      th Agent
                      th Message
                      th Ticket
                      th Acquitté par
                      th Actions
                  tbody
                    // Données fictives pour la mise en page
                    tr
                      td 2023-05-15 10:23
                      td srv-db01
                      td Espace disque faible (/data)
                      td 
                        a(href="#") #T-2458
                      td John Doe
                      td
                        .btn-group.btn-group-sm
                          button.btn.btn-outline-info(title="Détails")
                            i.fas.fa-eye
                          button.btn.btn-outline-success(title="Résoudre")
                            i.fas.fa-check-double
                    tr
                      td 2023-05-15 09:45
                      td srv-app03
                      td Service apache arrêté
                      td -
                      td Marie Martin
                      td
                        .btn-group.btn-group-sm
                          button.btn.btn-outline-info(title="Détails")
                            i.fas.fa-eye
                          button.btn.btn-outline-success(title="Résoudre")
                            i.fas.fa-check-double
                    tr
                      td 2023-05-14 23:12
                      td srv-web02
                      td Latence réseau élevée
                      td 
                        a(href="#") #T-2455
                      td Pierre Dupont
                      td
                        .btn-group.btn-group-sm
                          button.btn.btn-outline-info(title="Détails")
                            i.fas.fa-eye
                          button.btn.btn-outline-success(title="Résoudre")
                            i.fas.fa-check-double
                    tr
                      td 2023-05-14 18:05
                      td srv-db02
                      td Charge CPU élevée
                      td 
                        a(href="#") #T-2454
                      td Sophie Blanc
                      td
                        .btn-group.btn-group-sm
                          button.btn.btn-outline-info(title="Détails")
                            i.fas.fa-eye
                          button.btn.btn-outline-success(title="Résoudre")
                            i.fas.fa-check-double
                    tr
                      td 2023-05-14 15:42
                      td srv-cache01
                      td Service Redis - Mémoire > 85%
                      td -
                      td Luc Dubois
                      td
                        .btn-group.btn-group-sm
                          button.btn.btn-outline-info(title="Détails")
                            i.fas.fa-eye
                          button.btn.btn-outline-success(title="Résoudre")
                            i.fas.fa-check-double
                    tr
                      td 2023-05-14 11:23
                      td srv-app01
                      td API indisponible
                      td 
                        a(href="#") #T-2451
                      td John Doe
                      td
                        .btn-group.btn-group-sm
                          button.btn.btn-outline-info(title="Détails")
                            i.fas.fa-eye
                          button.btn.btn-outline-success(title="Résoudre")
                            i.fas.fa-check-double
            
            // Alertes résolues
            #resolved-alerts-tab.tab-pane.fade
              // Filtres
              .alert-filters.p-3.border-bottom
                form.row.g-3#resolved-alerts-filter-form
                  .col-md-3
                    label.form-label.small(for="resolved-severity-filter") Sévérité
                    select.form-select.form-select-sm#resolved-severity-filter
                      option(value="") Toutes
                      option(value="critical") Critique
                      option(value="warning") Avertissement
                      option(value="info") Information
                  
                  .col-md-3
                    label.form-label.small(for="resolved-agent-filter") Agent
                    select.form-select.form-select-sm#resolved-agent-filter
                      option(value="") Tous
                      // Options chargées dynamiquement
                  
                  .col-md-3
                    label.form-label.small(for="resolved-date-filter") Période
                    select.form-select.form-select-sm#resolved-date-filter
                      option(value="24h") Dernières 24h
                      option(value="7d") 7 derniers jours
                      option(value="30d") 30 derniers jours
                  
                  .col-md-3.d-flex.align-items-end
                    button.btn.btn-sm.btn-primary.w-100(type="submit")
                      i.fas.fa-filter.me-1
                      | Filtrer
              
              // Tableau d'alertes résolues
              .table-responsive
                table.table.table-hover.table-sm.mb-0#resolved-alerts-table
                  thead
                    tr
                      th Date
                      th Agent
                      th Message
                      th Résolu par
                      th Résolu le
                  tbody
                    // Données fictives pour la mise en page
                    tr
                      td 2023-05-14 08:15
                      td srv-web01
                      td Espace disque faible (/var/log)
                      td John Doe
                      td 2023-05-14 09:30
                    tr
                      td 2023-05-13 22:40
                      td srv-db01
                      td Service PostgreSQL lent
                      td Marie Martin
                      td 2023-05-14 08:12
                    tr
                      td 2023-05-13 18:22
                      td srv-app02
                      td Service Memcached arrêté
                      td Pierre Dupont
                      td 2023-05-13 19:45
                    tr
                      td 2023-05-13 14:10
                      td srv-web03
                      td Service Nginx - Erreurs 502
                      td Sophie Blanc
                      td 2023-05-13 15:30
                    tr
                      td 2023-05-13 10:05
                      td srv-app01
                      td File d'attente bloquée
                      td Luc Dubois
                      td 2023-05-13 11:45
      
      // Légende des statuts
      .card.dashboard-card.mb-3
        .card-header
          h5.mb-0
            i.fas.fa-info-circle.me-2.text-info
            | Légende des statuts
        .card-body.p-2
          .row
            .col-md-3.mb-2
              .d-flex.align-items-center
                .badge.bg-danger.me-2 Critique
                span Une intervention immédiate est requise
            .col-md-3.mb-2
              .d-flex.align-items-center
                .badge.bg-warning.me-2 Avertissement
                span À surveiller, intervention possible
            .col-md-3.mb-2
              .d-flex.align-items-center
                .badge.bg-info.me-2 Information
                span Notification sans gravité
            .col-md-3.mb-2
              .d-flex.align-items-center
                .badge.bg-success.me-2 Résolu
                span Le problème a été corrigé
              
  // Modal de détail d'alerte
  .modal.fade#alert-details-modal(tabindex="-1" aria-labelledby="alert-details-modal-label" aria-hidden="true")
    .modal-dialog.modal-lg
      .modal-content
        .modal-header
          h5.modal-title#alert-details-modal-label Détails de l'alerte
          button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Fermer")
        .modal-body
          .row
            .col-md-6
              .info-item
                .info-label ID
                .info-value#alert-id -
              .info-item
                .info-label Date de déclenchement
                .info-value#alert-date -
              .info-item
                .info-label Agent
                .info-value#alert-agent -
              .info-item
                .info-label Service
                .info-value#alert-service -
            .col-md-6
              .info-item
                .info-label Sévérité
                .info-value#alert-severity -
              .info-item
                .info-label Statut
                .info-value#alert-status -
              .info-item
                .info-label Acquitté par
                .info-value#alert-ack-by -
              .info-item
                .info-label Résolu le
                .info-value#alert-resolved -
          
          .row.mt-3
            .col-md-6
              .info-item
                .info-label Ticket associé
                .info-value#alert-ticket -
            .col-md-6
              .info-item
                .info-label Temps d'intervention
                .info-value#alert-resolution-time -
          
          hr
          
          .mb-3
            h6 Message
            .alert.alert-secondary#alert-message -
          
          .mb-3
            h6 Métrique concernée
            .alert.alert-info#alert-metric -
          
          .mb-3
            h6 Commentaires
            .alert.alert-light#alert-comments
              | Aucun commentaire
          
          .mb-3
            label.form-label(for="new-comment") Ajouter un commentaire
            textarea.form-control#new-comment(rows="3")
        
        .modal-footer
          .btn-group.me-auto
            button.btn.btn-warning#acknowledge-alert(type="button")
              i.fas.fa-check.me-1
              | Acquitter
            button.btn.btn-success#resolve-alert(type="button")
              i.fas.fa-check-double.me-1
              | Résoudre
            button.btn.btn-info#create-ticket(type="button")
              i.fas.fa-ticket-alt.me-1
              | Créer ticket
          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Fermer
          button.btn.btn-primary#add-comment-btn(type="button") Ajouter commentaire

block scripts
  script(src='/assets/js/monitoring/alerts-list.js') 